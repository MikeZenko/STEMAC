{
  "framework": "vite",
  "installCommand": "cd STEMAC && npx --yes pnpm@9.15.4 install --frozen-lockfile",
  "buildCommand": "cd STEMAC && npx --yes pnpm@9.15.4 run build",
  "outputDirectory": "STEMAC/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
